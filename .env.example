# Mission Control configuration — all optional (defaults auto-detected).
# Copy to server/.env or export these before `pnpm dev`.

# Ports
# MC_PORT=4711
# MC_WEB_PORT=5173

# Path to the `claude` CLI, if it isn't on your PATH
# MC_CLAUDE_BIN=/Users/you/.local/bin/claude

# AgentVault (the DATA CORE) — optional. Auto-detected as `python3 -m agentvault.mcp_server`.
# MC_VAULT_CMD=python3 -m agentvault.mcp_server
# MC_VAULT_DISABLED=1
